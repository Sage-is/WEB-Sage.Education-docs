# Hidden-artifact allowlist: deny dotfiles and dotfolders everywhere in the
# repo unless they are intentionally shared and explicitly included below.
.*
!/.gitignore
!/.gitattributes
!/.dockerignore
!/.editorconfig
!.*.example
!/.github/
!/.github/**
!/.node-version
!/.prettierignore
!/.prettierrc.mjs
!/.stylelintrc.json
!/.todoscope-exclude.csv
!/.vscode/
!/.vscode/**
!.obsidian/
!.obsidian/**
!.nojekyll

# Build & dependency output
/node_modules
/build
_site-eleventy/

# Local-only Obsidian workspace state inside TODO.obsidian/ (not a dotfolder)
/TODO.obsidian/workspace.json
